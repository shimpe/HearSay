<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:HearSay.Studio"
        x:Class="HearSay.Studio.MainWindow"
        x:DataType="local:MainViewModel"
        Title="HearSay Studio"
        Width="1220" Height="860"
        MinWidth="900" MinHeight="620"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Inter, Segoe UI, sans-serif">

  <Window.Resources>
    <local:IntensityToBrushConverter x:Key="CellBrush" />
    <local:IntensityToForegroundConverter x:Key="CellForeground" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Background" Value="{StaticResource EditorBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBox.mono:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource EditorBackgroundBrush}" />
    </Style>
    <Style Selector="TextBox.mono:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource EditorBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#67E8F9" />
      <Setter Property="Foreground" Value="#0F172A" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
      <Setter Property="Foreground" Value="#0F172A" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="{StaticResource EditorBackgroundBrush}" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#243247" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">

    <!-- Header -->
    <Border Grid.Row="0" CornerRadius="10" Padding="18,14">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#1E3A5F" />
          <GradientStop Offset="1" Color="#0F172A" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <local:HearSayLogo Width="44" Height="44" />
          <StackPanel>
            <TextBlock Text="HearSay Studio" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="audio → six-operator patch → SuperCollider FM7, FMX6 or Nome6" Classes="muted" FontSize="12" />
          </StackPanel>
        </StackPanel>
        <!-- Options and run -->
        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <WrapPanel.Styles>
            <Style Selector="WrapPanel > StackPanel">
              <Setter Property="Margin" Value="0,3,10,3" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="WrapPanel > StackPanel > :is(Control)">
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </WrapPanel.Styles>
          <!-- Each label stays with its control when the row wraps. -->
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="label" Text="Target" ToolTip.Tip="SuperCollider UGen the patch is searched for and exported to. FM7 (sc3-plugins): sine operators. FMX6 (github.com/shimpe/fmx6): sine, triangle, saw, square, pulse and noise operators. Nome6: Jacobi elliptic operators, from a sine to strong odd harmonics, morphing from sn to sd. All: the three, one after the other with the full budget each; every target keeps its result." />
            <ComboBox Width="130" ItemsSource="{Binding SynthesisTargets}" SelectedItem="{Binding SelectedSynthesisTarget}" IsEnabled="{Binding !IsRunning}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:SynthesisTargetChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="label" Text="Budget" ToolTip.Tip="Candidate evaluations; one evaluation renders every target note" />
            <NumericUpDown Width="150" Minimum="200" Maximum="1000000" Increment="1000" FormatString="0" Value="{Binding Budget}" IsEnabled="{Binding !IsRunning}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="label" Text="Seed" />
            <NumericUpDown Width="150" Minimum="0" Maximum="2147483647" Increment="1" FormatString="0" Value="{Binding Seed}" IsEnabled="{Binding !IsRunning}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="label" Text="Seeds" ToolTip.Tip="Run this many seeds with the full budget each; the best wins, and the finalists of every seed are saved as alternatives" />
            <NumericUpDown Width="100" Minimum="1" Maximum="16" Increment="1" FormatString="0" Value="{Binding Seeds}" IsEnabled="{Binding !IsRunning}" />
          </StackPanel>
          <CheckBox Content="Library" IsChecked="{Binding UseStructureLibrary}" IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center"
                    ToolTip.Tip="Also start from the patches of the structure library that sound most like the target: 300 000 random patches per synthesis target, built once (a few minutes) and kept on disk. They come on top of the structures read from the target and take about a quarter of the budget; give a third more budget to keep the same depth for the rest. Off: the whole budget goes to the structures read from the target." />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="▶  Run search" Classes="primary" Command="{Binding RunCommand}" />
            <Button Content="Stop" Command="{Binding CancelCommand}" />
          </StackPanel>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Body: the search and the library browser -->
    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Padding="0,8,0,0">
      <TabItem>
        <TabItem.Header><TextBlock Text="Search" FontSize="15" /></TabItem.Header>
        <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12">

          <!-- Left column: targets and result -->
          <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="12">
            <Border Grid.Row="0" Classes="card">
              <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Classes="title" Text="TARGET NOTES" Margin="0" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="Add WAV…" Click="OnAdd" IsEnabled="{Binding !IsRunning}" />
                  <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}" />
                  <Button Grid.Column="3" Content="Clear" Command="{Binding ClearCommand}" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" Height="168" Background="Transparent" IsEnabled="{Binding !IsRunning}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:TargetItem">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                        <Button Grid.Column="0" Width="30" Height="30" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnPlayTarget" ToolTip.Tip="Play this target">
                          <!-- A drawn triangle: a text glyph sits where its font puts it. Nudged right by a pixel, since a
                               triangle centred on its bounding box looks left of centre. -->
                          <Path Data="M 0,0 L 9,5.5 L 0,11 Z" Fill="{Binding $parent[Button].Foreground}" Margin="2,0,0,0" />
                        </Button>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Summary}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="label" Text="pitch" FontSize="11" />
                        <TextBox Grid.Column="3" Width="70" VerticalAlignment="Center" Text="{Binding Pitch}" Watermark="auto" ToolTip.Tip="MIDI note (0-127) or frequency in Hz; empty = estimate" LostFocus="OnPitchChanged" />
                        <TextBlock Grid.Column="4" Classes="label" Text="vel" FontSize="11" />
                        <TextBox Grid.Column="5" Width="56" VerticalAlignment="Center" Text="{Binding Velocity}" Watermark="1.0" ToolTip.Tip="0..1" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Classes="muted" FontSize="11" TextWrapping="Wrap" Text="Several notes of the same sound at different pitches or velocities are matched by one patch; that makes key scaling, velocity and fixed-frequency operators searchable." />
              </Grid>
            </Border>

            <Border Grid.Row="1" Classes="card" ClipToBounds="True">
              <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Classes="title" Text="RESULT" />
                  <TextBlock Grid.Column="1" Text="{Binding ResultsKept}" Classes="muted" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="Every target keeps its last result for this target set; switch the Target selector to compare them by ear" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">

                <!-- Stat tiles -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding Stats}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:StatTile">
                      <Border Background="{StaticResource EditorBackgroundBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                        <StackPanel>
                          <TextBlock Text="{Binding Label}" Classes="muted" FontSize="10" />
                          <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Per-note similarity -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding NoteRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:NoteRow">
                      <Grid ColumnDefinitions="120,*,40" ColumnSpacing="8" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Finalists: the one selected is shown below and played by the keyboard -->
                <StackPanel Grid.Row="2" Spacing="4" IsVisible="{Binding HasAlternatives}">
                  <TextBlock Text="finalists · select one to inspect, play and export it" Classes="muted" FontSize="10" />
                  <ListBox ItemsSource="{Binding Alternatives}" SelectedItem="{Binding SelectedAlternative}" MaxHeight="150" Background="{StaticResource EditorBackgroundBrush}" CornerRadius="6">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="local:AlternativeItem">
                        <Grid ColumnDefinitions="28,48,*" ColumnSpacing="8" Margin="0,1">
                          <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Loss}" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="audio loss, lower is better" />
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Structure}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Origin}" Classes="muted" FontSize="9" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>

                <!-- Keyboard: plays the shown patch at any pitch; the target notes are marked -->
                <StackPanel Grid.Row="3" Spacing="4" IsVisible="{Binding HasResult}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="play the result" Classes="muted" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding PlayingText}" FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="lower on a key = louder · amber dots = target notes" Classes="muted" FontSize="9" VerticalAlignment="Center" />
                  </Grid>
                  <!-- The Fluent scrollbar is an overlay; the margin under the keys gives it a strip of its own, and it is always shown there. -->
                  <ScrollViewer x:Name="KeyboardScroll" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False" LayoutUpdated="OnKeyboardLayoutUpdated">
                    <local:PianoKeyboard x:Name="Keyboard" Height="92" Margin="0,0,0,18" LowestNote="0" HighestNote="127" WhiteKeyWidth="26" MarkedNotes="{Binding TargetNotes}" NotePressed="OnNotePressed" />
                  </ScrollViewer>
                  <TextBlock Text="No audio device could be opened; the keyboard is silent." Classes="muted" FontSize="10" Foreground="{StaticResource AmberBrush}" IsVisible="{Binding !CanPlay}" />
                </StackPanel>
                <Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding HasResult}">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="modulation matrix" Classes="muted" FontSize="10" Margin="0,0,0,4" />
                    <Grid ColumnDefinitions="30,Auto" RowDefinitions="Auto,Auto">
                      <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding OperatorNames}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Width="38" FontSize="9" Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding OperatorNames}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Height="38" FontSize="9" Classes="muted" VerticalAlignment="Center" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding MatrixCells}" Width="228">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:MatrixCell">
                            <Border Width="36" Height="36" Margin="1" CornerRadius="4" Background="{Binding Intensity, Converter={StaticResource CellBrush}}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                              <TextBlock Text="{Binding Text}" FontSize="10" Foreground="{Binding Intensity, Converter={StaticResource CellForeground}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                    <TextBlock Text="rows: destination · columns: source · radians" Classes="muted" FontSize="9" Margin="0,4,0,0" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Classes="mono" Text="{Binding ResultSummary}" FontSize="11" MinHeight="260" />
                </Grid>
                <TextBlock Grid.Row="5" Text="Run a search to see the result here." Classes="muted" IsVisible="{Binding !HasResult}" />
                </Grid>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>

          <!-- Right column: SuperCollider code and block diagram -->
          <Border Grid.Column="1" Classes="card">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" Classes="title" Text="PATCH" Margin="0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Copy" Click="OnCopy" IsEnabled="{Binding HasResult}" ToolTip.Tip="Copy the SuperCollider code" />
                <Button Grid.Column="2" Content="Save result folder…" Click="OnSave" IsEnabled="{Binding HasResult}" />
              </Grid>
              <local:PatchView Code="{Binding Scd}" Watermark="{Binding ScdWatermark}" Patch="{Binding ShownPatch}" />
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header><TextBlock Text="Library" FontSize="15" /></TabItem.Header>
        <local:LibraryView DataContext="{Binding Library}" />
      </TabItem>
    </TabControl>

    <!-- Footer: progress and status -->
    <Border Grid.Row="2" Classes="card" Padding="14,10">
      <Grid ColumnDefinitions="*,220" ColumnSpacing="14">
        <TextBlock Grid.Column="0" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Progress}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
