<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HearSay.Studio.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Palette: deep blue-grey surfaces, cyan accent, amber for warnings. -->
    <Color x:Key="WindowBackground">#0F172A</Color>
    <Color x:Key="CardBackground">#1E293B</Color>
    <Color x:Key="CardBorder">#334155</Color>
    <Color x:Key="EditorBackground">#0B1220</Color>
    <Color x:Key="AccentColor">#22D3EE</Color>
    <Color x:Key="AccentDim">#0E7490</Color>
    <Color x:Key="TextPrimary">#E2E8F0</Color>
    <Color x:Key="TextMuted">#94A3B8</Color>
    <Color x:Key="Amber">#F59E0B</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackground}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorder}" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource EditorBackground}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDim}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource Amber}" />
    <Color x:Key="SystemAccentColor">#22D3EE</Color>
    <Color x:Key="SystemAccentColorDark1">#06B6D4</Color>
    <Color x:Key="SystemAccentColorDark2">#0891B2</Color>
    <Color x:Key="SystemAccentColorDark3">#0E7490</Color>
    <Color x:Key="SystemAccentColorLight1">#67E8F9</Color>
    <Color x:Key="SystemAccentColorLight2">#A5F3FC</Color>
    <Color x:Key="SystemAccentColorLight3">#CFFAFE</Color>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
