<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HearSay.Studio"
             xmlns:profiles="using:HearSay.Synthesis.Profiles"
             x:Class="HearSay.Studio.LibraryView"
             x:DataType="local:LibraryViewModel">
  <UserControl.Styles>
    <Style Selector="ToggleButton.empty">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- The Imported / Favourites switch: two buttons, the chosen one lit -->
    <Style Selector="RadioButton.segment">
      <Setter Property="Background" Value="#334155" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="6,3">
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.segment:checked">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#0B1220" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="*,Auto" ColumnDefinitions="3*,2*" RowSpacing="12" ColumnSpacing="12">

    <!-- Graph: profile, breadcrumb, families -->
    <Border Grid.Row="0" Grid.Column="0" Classes="card">
      <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Classes="title" Text="LIBRARY" Margin="0" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" Width="110" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="profiles:SynthesisProfile">
                <TextBlock Text="{Binding Name, Converter={x:Static local:ProfileNameConverter.Instance}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="3" Content="Filter ▾" IsEnabled="{Binding FilterRows.Count}" ToolTip.Tip="Show only some sounds: values in a row are alternatives, rows must all hold">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ItemsControl ItemsSource="{Binding FilterRows}" MaxWidth="420">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:TraitRow">
                      <StackPanel Spacing="3" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Title}" Classes="muted" FontSize="10" />
                        <ItemsControl ItemsSource="{Binding Chips}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:TraitChip">
                              <ToggleButton Content="{Binding Text}" IsChecked="{Binding IsChosen, Mode=TwoWay}" Classes.empty="{Binding IsEmpty}" Padding="8,2" FontSize="11" Margin="0,0,4,4" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="4" Content="Import folder…" Click="OnImport" ToolTip.Tip="Read the patch.json files of exported results under a folder; click one in the list to place it among the library sounds like it" />
        </Grid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Crumbs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:Crumb">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Content="{Binding Label}" Click="OnCrumb" Padding="6,2" FontSize="11" Background="Transparent" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="›" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding HasFilter}">
          <TextBlock Grid.Column="0" Text="{Binding FilterSummary}" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilterSummary}" />
          <Button Grid.Column="1" Content="Clear" Click="OnClearFilter" Padding="6,2" FontSize="11" Background="Transparent" Foreground="{StaticResource AccentBrush}" />
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <!-- Side list: the sounds imported this session, or the favourites kept between sessions -->
          <Grid Grid.Column="0" Width="170" RowDefinitions="Auto,*,Auto" RowSpacing="4" IsVisible="{Binding HasSideList}">
            <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="4">
              <RadioButton Grid.Column="0" Classes="segment" Content="Favourites" GroupName="SideList" IsChecked="{Binding ShowFavourites}" FontSize="11" />
              <RadioButton Grid.Column="1" Classes="segment" Content="Imported" GroupName="SideList" IsChecked="{Binding ShowImports}" FontSize="11" />
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Imports}" Background="{StaticResource EditorBackgroundBrush}" CornerRadius="6" IsVisible="{Binding ShowImports}" Tapped="OnImportTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:ImportedItem">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProfileName}" Classes="muted" FontSize="9" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ListBox Grid.Row="1" ItemsSource="{Binding Favourites}" SelectedItem="{Binding SelectedFavourite}" Background="{StaticResource EditorBackgroundBrush}" CornerRadius="6" IsVisible="{Binding ShowFavourites}" Tapped="OnFavouriteTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:FavouriteItem">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Text="{Binding ProfileName}" Classes="muted" FontSize="9" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="4" IsVisible="{Binding ShowFavourites}">
              <Button x:Name="RenameButton" Grid.Column="0" Content="Rename" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding HasSelectedFavourite}">
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedLeft" Opening="OnRenameOpening">
                    <StackPanel Spacing="6" Width="220">
                      <TextBlock Text="New nickname" Classes="muted" FontSize="11" />
                      <TextBox x:Name="RenameBox" Text="{Binding FavouriteNickname}" KeyDown="OnRenameKeyDown" />
                      <Button Content="Rename" Click="OnRename" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button x:Name="RemoveButton" Grid.Column="1" Content="Remove" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding HasSelectedFavourite}">
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedLeft">
                    <StackPanel Spacing="6" Width="220">
                      <TextBlock Text="{Binding SelectedFavourite.Name, StringFormat='Remove {0} from the favourites? Its folder is deleted.'}" TextWrapping="Wrap" FontSize="11" />
                      <Button Content="Remove" Click="OnRemoveFavourite" HorizontalAlignment="Right" Foreground="{StaticResource AmberBrush}" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Grid>
          <Border Grid.Column="1" CornerRadius="6" ClipToBounds="True">
            <local:LibraryGraph x:Name="Graph" Nodes="{Binding Nodes}" Edges="{Binding Edges}" SelectedIndex="{Binding SelectedIndex}" Message="{Binding GraphMessage}" NodeClicked="OnNodeClicked" NodeOpened="OnNodeOpened" />
          </Border>
        </Grid>
      </Grid>
    </Border>

    <!-- The selected sound -->
    <Border Grid.Row="0" Grid.Column="1" Classes="card">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
          <TextBlock Grid.Column="0" Classes="title" Text="PATCH" Margin="0" VerticalAlignment="Center" />
          <Button x:Name="FavouriteButton" Grid.Column="1" Content="{Binding FavouriteStar}" FontSize="16" Padding="8,0" Foreground="{StaticResource AmberBrush}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Keep this sound as a favourite, with a nickname; the Favourites list beside the graph has them all">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" Opening="OnFavouriteOpening">
                <StackPanel Spacing="6" Width="240">
                  <TextBlock Text="Nickname" Classes="muted" FontSize="11" />
                  <TextBox x:Name="FavouriteBox" Text="{Binding FavouriteNickname}" KeyDown="OnFavouriteKeyDown" />
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Button Content="Remove" Click="OnRemoveShownFavourite" IsVisible="{Binding IsShownFavourite}" Foreground="{StaticResource AmberBrush}" />
                    <Button Content="Save" Click="OnSaveFavourite" />
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="2" Content="Copy" Click="OnCopy" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Copy the SuperCollider code" />
          <Button Grid.Column="3" Content="Save…" Click="OnSave" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Write patch.json, patch.scd and preview.wav to a folder; it can be imported again" />
          <Button Grid.Column="4" Content="Show in Search" Click="OnShowInSearch" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Show this sound as the patch of the Search tab" />
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectionText}" Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
        <local:PatchView Code="{Binding Scd}" Patch="{Binding ShownPatch}" SharedNoise="{Binding ShownPatchSharesNoise}" Watermark="Click a node to see its code." />
      </DockPanel>
    </Border>

    <!-- Keyboard -->
    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="card" Padding="14,10">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="play the last clicked sound" Classes="muted" FontSize="10" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding PlayingText}" FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="hold a key to sustain · lower on a key = louder" Classes="muted" FontSize="9" VerticalAlignment="Center" />
        </Grid>
        <ScrollViewer x:Name="KeyboardScroll" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False" LayoutUpdated="OnKeyboardLayoutUpdated">
          <local:PianoKeyboard x:Name="Keyboard" Height="80" Margin="0,0,0,18" LowestNote="0" HighestNote="127" WhiteKeyWidth="26" SoundingNotes="{Binding SoundingNotes}" NotePressed="OnNotePressed" NoteReleased="OnNoteReleased" />
        </ScrollViewer>
        <TextBlock Text="No audio device; the keyboard is silent." Classes="muted" FontSize="10" Foreground="{StaticResource AmberBrush}" IsVisible="{Binding !CanPlay}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
