<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HearSay.Studio"
             x:Class="HearSay.Studio.PatchView"
             x:Name="Root">
  <UserControl.Styles>
    <!-- The Original | Edited switch: two buttons, the chosen one lit -->
    <Style Selector="RadioButton.segment">
      <Setter Property="Background" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="8,3">
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.segment:checked">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#0B1220" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <TabControl x:Name="Tabs" Grid.Row="1" Padding="0,6,0,0">
      <TabItem Header="{Binding CodeHeader, ElementName=Root}" FontSize="13">
        <TextBox Classes="mono" Text="{Binding Code, ElementName=Root}" Watermark="{Binding Watermark, ElementName=Root}" />
      </TabItem>
      <TabItem Header="Block diagram" FontSize="13">
        <!-- Beside the diagram while a sound is shown: the inspector of the selected part, or a hint while nothing is
             selected, so that the diagram keeps its width when a part is selected or deselected -->
        <Grid ColumnDefinitions="*,Auto">
          <Border Background="{StaticResource EditorBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <Panel>
              <!-- Editing while a sound is shown: click to select, drag the underlined numbers sideways -->
              <local:FmDiagram x:Name="Diagram" Patch="{Binding Patch, ElementName=Root}" SharedNoise="{Binding SharedNoise, ElementName=Root}" Margin="8"
                               IsEditing="{Binding Editor.HasSound, ElementName=Root, FallbackValue=False}"
                               CanNudge="{Binding Editor.ShowingEdited, ElementName=Root, FallbackValue=False}"
                               SelectedPart="{Binding Editor.Selected, ElementName=Root, Mode=TwoWay}" />
              <!-- While the tab shows no sound: a new one, one sine, to build on (below the diagram's placeholder text) -->
              <Button x:Name="StartFromScratchButton" Content="Start from scratch" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14,6"
                      Command="{Binding StartFromScratchCommand, ElementName=Root}"
                      IsVisible="{Binding CanStartFromScratch, ElementName=Root}"
                      ToolTip.Tip="A new sound, one sine at ratio 1, to build on in the block diagram" />
            </Panel>
          </Border>
          <Panel x:Name="InspectorColumn" Grid.Column="1" Width="272" Margin="8,0,0,0"
                 IsVisible="{Binding Editor.HasSound, ElementName=Root, FallbackValue=False}">
            <local:PatchInspector x:Name="Inspector"
                                  DataContext="{Binding Editor, ElementName=Root}"
                                  IsVisible="{Binding Editor.Selected, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
            <Border x:Name="InspectorHint" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8"
                    IsVisible="{Binding Editor.Selected, ElementName=Root, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=True}">
              <TextBlock Text="Click a part of the diagram to edit it." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
            </Border>
          </Panel>
        </Grid>
      </TabItem>
    </TabControl>
    <!-- Editing: undo, redo, Match loudness, and once edited the switch to compare with the original. On the right of the
         tab strip where it fits beside the tab headers, else in a row of its own above them (PatchView.PlaceToolbar) -->
    <StackPanel x:Name="EditToolbar" Grid.Row="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"
                IsVisible="{Binding Editor.HasSound, ElementName=Root, FallbackValue=False}">
      <Button x:Name="UndoButton" Content="↶" FontSize="15" Padding="9,1" Click="OnUndo"
              IsEnabled="{Binding Editor.CanUndo, ElementName=Root, FallbackValue=False}" ToolTip.Tip="Undo the last edit (Ctrl+Z)" />
      <Button x:Name="RedoButton" Content="↷" FontSize="15" Padding="9,1" Click="OnRedo"
              IsEnabled="{Binding Editor.CanRedo, ElementName=Root, FallbackValue=False}" ToolTip.Tip="Redo the edit undone last (Ctrl+Y or Ctrl+Shift+Z)" />
      <Button x:Name="MatchLoudnessButton" Content="Match loudness" FontSize="11" Padding="8,3" VerticalAlignment="Center" Click="OnMatchLoudness"
              IsEnabled="{Binding Editor.CanMatchLoudness, ElementName=Root, FallbackValue=False}"
              ToolTip.Tip="An edit plays at the original's loudness: play it as loud as a new sound of it would be (later edits keep this loudness; click again to match the edit as it then is)" />
      <Border x:Name="EditSwitch" Background="{StaticResource EditorBackgroundBrush}" CornerRadius="6" Padding="2" VerticalAlignment="Center"
              IsVisible="{Binding Editor.IsEdited, ElementName=Root, FallbackValue=False}"
              ToolTip.Tip="What the diagram and the code show and the keys play: the sound as it was, or as edited">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <RadioButton x:Name="OriginalChoice" Classes="segment" Content="Original" FontSize="11"
                       IsChecked="{Binding Editor.ShowingOriginal, ElementName=Root, Mode=TwoWay, FallbackValue=False}" />
          <RadioButton x:Name="EditedChoice" Classes="segment" Content="Edited" FontSize="11"
                       IsChecked="{Binding Editor.ShowingEdited, ElementName=Root, Mode=TwoWay, FallbackValue=True}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
