<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HearSay.Modeling</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.2.0</Version>
    <Description>Optimization history, parameter-effect learning, local sensitivities and guidance: what effects have parameter changes had on audio features?</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HearSay.Audio\HearSay.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HearSay.OperatorMatrix" />
    <InternalsVisibleTo Include="HearSay.Modeling.Tests" />
    <InternalsVisibleTo Include="HearSay.Benchmarks" />
  </ItemGroup>

</Project>
