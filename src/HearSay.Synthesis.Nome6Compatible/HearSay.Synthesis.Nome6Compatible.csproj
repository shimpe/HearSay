<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HearSay.Synthesis.Nome6Compatible</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.2.0</Version>
    <Description>Offline reference renderer that reproduces the discrete-time behaviour of the SuperCollider Nome6 UGen: six Jacobi elliptic phase-modulation operators.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HearSay.Synthesis/HearSay.Synthesis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HearSay.Synthesis.Nome6Compatible.Tests" />
    <InternalsVisibleTo Include="HearSay.IntegrationTests" />
    <InternalsVisibleTo Include="HearSay.Benchmarks" />
  </ItemGroup>

</Project>
