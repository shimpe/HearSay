<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HearSay</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.1.0</Version>
    <Description>Diagnostic comparison of two audio tones of the same musical note, designed as the measurement and feedback layer of a closed-loop synthesizer parameter optimizer.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HearSay.Tests" />
    <InternalsVisibleTo Include="HearSay.Benchmarks" />
  </ItemGroup>

</Project>
